int16_t  Pcs_InvCtrl_SoftStar(void)
{
    static int16_t m_i16_VrefRunM = 0;


    if(tCpu2Cla.PwmStartEnable == 0)
    {
        m_i16_VrefRunM   = 0;
    }
    else
    {
        if(m_st_TimerFlag.u16_b5ms == 1)
        {
            if(m_i16_VrefRunM == Cpu1Ipc_cm2cpu.VF_VoSet)
            {
                m_i16_VrefRunM = Cpu1Ipc_cm2cpu.VF_VoSet;
            }
            else if(m_i16_VrefRunM < Cpu1Ipc_cm2cpu.VF_VoSet)
            {
                m_i16_VrefRunM += INV_SOFTSTART_STEP;

                if(m_i16_VrefRunM > Cpu1Ipc_cm2cpu.VF_VoSet)
                {
                    m_i16_VrefRunM = Cpu1Ipc_cm2cpu.VF_VoSet;
                }
            }
            else if(m_i16_VrefRunM > Cpu1Ipc_cm2cpu.VF_VoSet)
            {
                m_i16_VrefRunM -= INV_SOFTSTART_STEP;

                if(m_i16_VrefRunM < Cpu1Ipc_cm2cpu.VF_VoSet)
                {
                    m_i16_VrefRunM = Cpu1Ipc_cm2cpu.VF_VoSet;
                }
            }
        }
    }

    tCpu2Cla.Pcs_VinvMdRef   = (float32_t)m_i16_VrefRunM*0.1f;

    return 0;
}

