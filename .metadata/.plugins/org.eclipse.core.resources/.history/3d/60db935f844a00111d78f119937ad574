void  Pcs_InterRef_Gen(void)
{
    float32_t gen_angle_radians;
    float32_t gen_sineA,gen_sineB,gen_sineC;

    // Generate the RAMP TINV_angle
    RAMPGEN_run(&PCS_rgen);
    // Compute TINV_angle and sine and cosine
    gen_angle_radians = PCS_rgen.out * PI * 2.0f;
    // Use the TINV_angle value to compute the sine value
    gen_sineA     = sinf(gen_angle_radians);
    gen_sineB     = sinf(gen_angle_radians - PI * 2.0f / 3.0f);
    gen_sineC     = sinf(gen_angle_radians - PI * 4.0f / 3.0f);
    // Run ABC_DQ0 on the internally generated sine values
    ABC_DQ0_POS_run(&PCS_InteRef_dq0_pos,
                    gen_sineA,gen_sineB,gen_sineC,
                    PcsGen_sine, PcsGen_cosine);

    SPLL_3PH_SRF_run(PCS_InteRef_dq0_pos.q, &PCS_spll_3ph_rgen);
    Pcs_Localpllfo = PCS_spll_3ph_rgen.fo;
    PcsGen_sine    = sinf(PCS_spll_3ph_rgen.theta[1]);
    PcsGen_cosine  = cosf(PCS_spll_3ph_rgen.theta[1]);
}


void  Pcs_GridRef_Pll(void)
{
    float32_t Pcs_vGrid_A_sensed_pu,Pcs_vGrid_B_sensed_pu,Pcs_vGrid_C_sensed_pu;
    float32_t pcs_sin,pcs_cos;

    pcs_sin    = PcsGrid_sine;
    pcs_cos    = PcsGrid_cosine;

    Pcs_vGrid_A_sensed_pu  = tCla2Cpu.Pcs_vGrid_A_sensed_pu;
    Pcs_vGrid_B_sensed_pu  = tCla2Cpu.Pcs_vGrid_B_sensed_pu;
    Pcs_vGrid_C_sensed_pu  = tCla2Cpu.Pcs_vGrid_C_sensed_pu;
    clarkT_run(&Pcs_GridRef_alphaBeta,
                   Pcs_vGrid_A_sensed_pu, Pcs_vGrid_B_sensed_pu, Pcs_vGrid_C_sensed_pu);
    ParkT_Pos_run(&Pcs_GridRef_dq0_pos,
                   Pcs_GridRef_alphaBeta.alpha, Pcs_GridRef_alphaBeta.beta, Pcs_GridRef_alphaBeta.zero,
                   pcs_sin, pcs_cos);
    ParkT_Neg_run(&Pcs_GridRef_dq0_neg,
                   Pcs_GridRef_alphaBeta.alpha, Pcs_GridRef_alphaBeta.beta, Pcs_GridRef_alphaBeta.zero,
                   pcs_sin, pcs_cos);

    SPLL_3PH_DDSRF_run(&PCS_spll_3ph_grid,
                       Pcs_GridRef_dq0_pos.d, Pcs_GridRef_dq0_neg.d,
                       Pcs_GridRef_dq0_pos.q, Pcs_GridRef_dq0_neg.q);

    PcsGrid_sine   = sinf(PCS_spll_3ph_grid.theta[1]);
    PcsGrid_cosine = cosf(PCS_spll_3ph_grid.theta[1]);
//    SPLL_3PH_SRF_run(Pcs_GridRef_dq0_pos.q, &PCS_spll_3ph_grid);
    if((Pcs_Gridpllfo < 40.0f)&&(Pcs_Output_Meter.PCS_AC_Freq_A < 5.0f)&&(Pcs_Output_Meter.PCS_AC_Freq_B < 5.0f)&&(Pcs_Output_Meter.PCS_AC_Freq_C < 5.0f))
        SPLL_3PH_DDSRF_reset(&PCS_spll_3ph_grid);

    tCpu2Cla.Pcs_vGrid_dq0_pos_d    = Pcs_GridRef_dq0_pos.d;
    tCpu2Cla.Pcs_vGrid_dq0_pos_q    = Pcs_GridRef_dq0_pos.q;
    tCpu2Cla.Pcs_vGrid_dq0_pos_z    = Pcs_GridRef_dq0_pos.z;
    tCpu2Cla.Pcs_vGrid_dq0_neg_d    = Pcs_GridRef_dq0_neg.d;
    tCpu2Cla.Pcs_vGrid_dq0_neg_q    = Pcs_GridRef_dq0_neg.q;
    tCpu2Cla.Pcs_vGrid_dq0_neg_z    = Pcs_GridRef_dq0_neg.z;
}

// Lab1 ISR code
int16_t Cnt_PwmEnDelay;

#pragma FUNC_ALWAYS_INLINE(Pcs_runISR1)
inline void Pcs_runISR1(void)
{
    switch(i16_IntCnt)
    {
        case 0:
            obj_PcsOutput_RmsCalc();
            i16_IntCnt = 1;
            break;
        case 1:
            obj_PcsOutput_PowerMeasAC();
            i16_IntCnt = 2;
            break;
        case 2:
            obj_PcsOutput_PowerMeas();
            ipc_TxData_Cpu1ToCM(ipcCmd_Param,sizeof(Cpu1Ipc_cpu2cm));
            i16_IntCnt = 3;
            break;
        default:
            i16_IntCnt = 0;
            break;
    }
    Pcs_InterRef_Gen();
    Pcs_GridRef_Pll();
    Cpu1Ipc_cpu2cm.pllPhaseErr = (int16_t)((PCS_spll_3ph_rgen.theta[1]-PCS_spll_3ph_grid.theta[1])*573.25f);

    if((i16_IntCnt == 3)&&(Cpu1Ipc_cm2cpu.debugData_TxEn))
    {
        debugpData[0] = tCla2Cpu.Pcs_vGrid_A_sensed_pu;
        debugpData[1] = tCla2Cpu.Pcs_vGrid_B_sensed_pu;
        debugpData[2] = tCla2Cpu.Pcs_vGrid_C_sensed_pu;
        debugpData[3] = tCla2Cpu.Pcs_iGrid_A_sensed_pu;
        debugpData[4] = tCla2Cpu.Pcs_iGrid_B_sensed_pu;
        debugpData[5] = tCla2Cpu.Pcs_iGrid_C_sensed_pu;
        debugpData[6] = tCla2Cpu.Pcs_vBus_sensed_pu*PCS_VDC_MAX_SENSE_VOLTS;
        debugpData[7] = tCla2Cpu.Pcs_iInv_Iod;//tCla2Cpu.Pcs_iBus_sensed_pu*PCS_IDC_MAX_SENSE_VOLTS;
        debugpData[8] = tCla2Cpu.Pcs_iInv_Ioq;//tCla2Cpu.Pcs_vdRatio_pu*100.0f;//tCla2Cpu.Pcs_vBusP_sensed_pu;
        debugpData[9] = PCS_spll_3ph_rgen.theta[1]*57.325f;//tCla2Cpu.Pcs_vBatt_sensed_pu*PCS_VBATT_MAX_SENSE_VOLTS;
        ipc_TxData_Cpu1ToCM(IPC_CMD_DEBUG,10);
    }

    tCpu2Cla.Pcs_sine      = PcsGen_sine;
    tCpu2Cla.Pcs_cosine    = PcsGen_cosine;

    tCpu2Cla.Pcs_Gridsine      = PcsGrid_sine;
    tCpu2Cla.Pcs_Gridcosine    = PcsGrid_cosine;

#if PWM_SYNC_TEST_MODE
    Drv_PwmOnset();
#else
    if((Cpu1Ipc_cpu2cm.PcsCtrlState == PcsOn_Mode)&&(tCpu2Cla.PwmStartEnable==1))
    {
        if(Cnt_PwmEnDelay < 200)
        {
            Cnt_PwmEnDelay++;
        }
        else
        {
            Drv_PwmOnset();
        }
    }
    else
    {
        Cnt_PwmEnDelay = 0;
        Drv_PwmOffset();
    }
#endif
}


