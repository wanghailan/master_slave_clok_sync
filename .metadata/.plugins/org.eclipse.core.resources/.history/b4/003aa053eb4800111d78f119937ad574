/*
 * pwm_slave_sync.c
 *
 * 功能：
 *    Slave侧PPS同步PWM。
 *    通过eCAP1捕获经PTP协议同步后的PPS上升沿，
 *    在确认PTP已锁定（Cpu1Ipc_cm2cpu.PtpSynced==1）后，
 *    校正EPWM1相位，使其与Master的PWM间接对齐。
 */

#include "pwm_slave_sync.h"
#include "bsp.h"


#define PPS_INPUTXBAR_CHANNEL       XBAR_INPUT7            // 内部路由(AUXSIG2 -> INPUTXBAR7)
#define PPS_ECAP_INPUT_SEL          ECAP_INPUT_INPUTXBAR7  // INPUTXBAR7 -> ECAP1
#define SYNC_EPWM_BASE              EPWM1_BASE             // ePWM1为同步基准模块
#define EPWM_TBCLK_HZ               200000000UL            // 时钟频率
#define ECAP_TSCTR_HZ               200000000UL

// 控制参数
#define PWM_MAX_STEP_NS             100L
#define PWM_LOCK_THRESHOLD_NS       50L
#define PPS_ISR_MAX_LATENCY_NS      5000UL

#define SLAVE_PWM_BASE_PHASE        0U       // PWM基准相位
#define MAX_INTERGRAL_THRESHOLD     500.0f   // 积分限幅
#define XBAR_INPUT7_SRC_AUX_SIG2    0x12U    // XBAR INPUT7内部源选择AUXSIG2


extern IPC_DATA_CM2CPU    Cpu1Ipc_cm2cpu;    //从CM核获取PTP同步状态

static volatile uint32_t g_slavePpsCapCount = 0;
static volatile int32_t  g_slavePwmPhaseErrTicks = 0;
static volatile int32_t  g_slavePwmPhaseErrNs = 0;
static volatile uint32_t g_slavePwmLockCount = 0U;
static volatile uint32_t g_slavePwmSkipCount = 0U;
static volatile bool     g_slavePwmLocked = false;


static void Slave_InitEPwmSync(void);
static void Slave_InitPpsEcap(void);
static void Slave_ServicePpsCapture(bool allowSync);

static int32_t  ns_to_tbclk_ticks(int32_t ns);
static uint32_t ns_to_ecap_ticks(uint32_t ns);
static uint32_t ecap_ticks_to_tbclk(uint32_t ecapTicks);
static uint32_t wrap_u32(int32_t value, uint32_t modulo);
static int32_t  signed_phase_error(uint32_t actual, uint32_t target, uint32_t modulo);
static int32_t  clamp_i32(int32_t value, int32_t minValue, int32_t maxValue);


// 初始化函数
void PWM_SlaveSync_Init(void)
{
    // 1. 配置 PWM1 同步功能
    Slave_InitEPwmSync();

    // 2. PPS eCAP
    Slave_InitPpsEcap();
}

// Slave EPWM1同步配置
static void Slave_InitEPwmSync(void)
{
    EALLOW;

    // 冻结时基时钟
    SysCtl_disablePeripheral(SYSCTL_PERIPH_CLK_TBCLKSYNC);

    // 1. 配置EPWM1：不接收外部同步
    EPWM_setSyncInPulseSource(SYNC_EPWM_BASE, EPWM_SYNC_IN_PULSE_SRC_DISABLE);

    // 2. 初始相位偏移
    EPWM_setPhaseShift(SYNC_EPWM_BASE, 0U);

    // 3. EPWM1在CTR=0时输出同步脉冲，供其余通道级联
    EPWM_enableSyncOutPulseSource(SYNC_EPWM_BASE, EPWM_SYNC_OUT_PULSE_ON_CNTR_ZERO);

    // 4. 恢复时基时钟——关键！
    SysCtl_enablePeripheral(SYSCTL_PERIPH_CLK_TBCLKSYNC);

    EDIS;
}

// PPS eCAP初始化
static void Slave_InitPpsEcap(void)
{
    EALLOW;

    // 确保CM核产生的内部PPS信号已经使能并稳定
    XBAR_setInputPin(INPUTXBAR_BASE, PPS_INPUTXBAR_CHANNEL, XBAR_INPUT7_SRC_AUX_SIG2);

    // 选择eCAP的输入源
    ECAP_selectECAPInput(PPS_ECAP_BASE, PPS_ECAP_INPUT_SEL);

    // 注册中断服务
    Interrupt_register(PPS_ECAP_INT, PPS_Slave_ECAP_ISR);

    ECAP_disableInterrupt(PPS_ECAP_BASE, 0xFFFFU);
    ECAP_stopCounter(PPS_ECAP_BASE);
    ECAP_enableCaptureMode(PPS_ECAP_BASE);

    // 连续捕获模式：EVENT1锁存时间戳到CAP1
    ECAP_setCaptureMode(PPS_ECAP_BASE, ECAP_CONTINUOUS_CAPTURE_MODE, ECAP_EVENT_1);
    ECAP_setEventPolarity(PPS_ECAP_BASE, ECAP_EVENT_1, ECAP_EVNT_RISING_EDGE);

    // 捕获后TSCTR不自动清零
    ECAP_disableCounterResetOnEvent(PPS_ECAP_BASE, ECAP_EVENT_1);
    ECAP_enableTimeStampCapture(PPS_ECAP_BASE);

    // 清除eCAP旧事件标志
    ECAP_clearInterrupt(PPS_ECAP_BASE,
                        ECAP_ISR_SOURCE_CAPTURE_EVENT_1 |
                        ECAP_ISR_SOURCE_COUNTER_OVERFLOW);
    ECAP_clearGlobalInterrupt(PPS_ECAP_BASE);

    // 打开CAP1中断
    ECAP_enableInterrupt(PPS_ECAP_BASE, ECAP_ISR_SOURCE_CAPTURE_EVENT_1);

    // 启动eCAP计数器并重新arm
    ECAP_startCounter(PPS_ECAP_BASE);
    ECAP_reArm(PPS_ECAP_BASE);

    // 使能CPU/PIE层eCAP中断
    Interrupt_enable(PPS_ECAP_INT);

    EDIS;
}

// PPS 中断服务
__interrupt void PPS_Slave_ECAP_ISR(void)
{
    Slave_ServicePpsCapture(true);

    ECAP_clearInterrupt(PPS_ECAP_BASE, ECAP_ISR_SOURCE_CAPTURE_EVENT_1);
    ECAP_clearGlobalInterrupt(PPS_ECAP_BASE);
    Interrupt_clearACKGroup(INTERRUPT_ACK_GROUP4);
}

// PPS 捕获处理核心函数
static void Slave_ServicePpsCapture(bool allowSync)
{
    uint32_t capTs;
    uint32_t nowTs;
    uint32_t dtEcap;
    uint32_t dtTbclk;
    uint32_t tbprd;
    uint32_t modulo;
    uint32_t targetAtPps;
    uint32_t targetNow;
    uint32_t actualNow;
    int32_t  err;
    int32_t  step;
    uint32_t newPhase;

    g_slavePpsCapCount++;

    // 读取 PPS 时间戳与当前时间戳
    capTs = ECAP_getEventTimeStamp(PPS_ECAP_BASE, ECAP_EVENT_1);
    nowTs = ECAP_getTimeBaseCounter(PPS_ECAP_BASE);
    dtEcap = nowTs - capTs;
    dtTbclk = ecap_ticks_to_tbclk(dtEcap);

    if (allowSync == false)
    {
        g_slavePwmLocked = false;
        g_slavePwmLockCount = 0U;
        return;
    }

    /*
     * 关键保护：PTP 未同步时，PPS 相位可能漂移，此时禁止校正 PWM。
     * 等待 PTP 协议锁定后（PtpSynced==1），再开始相位闭环。
     */
    if (Cpu1Ipc_cm2cpu.PtpSynced == 0)
    {
        g_slavePwmLocked = false;
        g_slavePwmLockCount = 0U;
        return;
    }

    // ISR 延迟过大则跳过本次
    if (dtEcap > ns_to_ecap_ticks(PPS_ISR_MAX_LATENCY_NS))
    {
        g_slavePwmSkipCount++;
        return;
    }

    tbprd = EPWM_getTimeBasePeriod(SYNC_EPWM_BASE);

    //
    // modulo 说明：
    // UP-count模式：计数范围 0~TBPRD，共TBPRD+1个tick。
    // 使用UP-DOWN count，modulo应为2*TBPRD，需同步修改targetNow计算。
    //
    modulo = 2 * tbprd;  // 使用UP-DOWN count

    // PPS 时刻的目标相位
    targetAtPps = wrap_u32(ns_to_tbclk_ticks(PPS_PHASE_OFFSET_NS), modulo);

    // 当前时刻目标相位
    targetNow = (targetAtPps + (dtTbclk % modulo)) % modulo;

    // 实际EPWM计数器值
    actualNow = (uint32_t)EPWM_getTimeBaseCounterValue(SYNC_EPWM_BASE);

    // 带环绕处理的最短相位误差
    err = signed_phase_error(actualNow, targetNow, modulo);

    g_slavePwmPhaseErrTicks = err;
    g_slavePwmPhaseErrNs = (int32_t)(((int64_t)err * 1000000000LL) / (int64_t)EPWM_TBCLK_HZ);

    //
    // 并机前/未锁定：直接拉到目标相位。
    // 已锁定运行：小步进校正，避免PWM相位突跳。
    //
    if ((g_slavePwmLocked == false) ||
        (err > ns_to_tbclk_ticks(PWM_LOCK_THRESHOLD_NS)) ||
        (err < -ns_to_tbclk_ticks(PWM_LOCK_THRESHOLD_NS)))
    {
        if (g_slavePwmLocked == false)
        {
            newPhase = targetNow;   // 首次对齐直接拉过去
        }
        else
        {
            step = clamp_i32(err,
                             -ns_to_tbclk_ticks(PWM_MAX_STEP_NS),
                              ns_to_tbclk_ticks(PWM_MAX_STEP_NS));
            newPhase = wrap_u32((int32_t)actualNow - step, modulo);
        }

        // 使用ePWM同步机制装载TBPHS
        EPWM_setPhaseShift(SYNC_EPWM_BASE, (uint16_t)newPhase);
        EPWM_forceSyncPulse(SYNC_EPWM_BASE);

        g_slavePwmLockCount = 0U;
    }
    else
    {
        if (g_slavePwmLockCount < 0xFFFFFFFFU)
        {
            g_slavePwmLockCount++;
        }
        if (g_slavePwmLockCount >= 3U)
        {
            g_slavePwmLocked = true;
        }
    }
}

// 辅助函数
static int32_t ns_to_tbclk_ticks(int32_t ns)
{
    int64_t ticks = ((int64_t)ns * (int64_t)EPWM_TBCLK_HZ) / 1000000000LL;
    return (int32_t)ticks;
}

static uint32_t ns_to_ecap_ticks(uint32_t ns)
{
    return (uint32_t)(((uint64_t)ns * (uint64_t)ECAP_TSCTR_HZ) / 1000000000ULL);
}

static uint32_t ecap_ticks_to_tbclk(uint32_t ecapTicks)
{
    return (uint32_t)(((uint64_t)ecapTicks * (uint64_t)EPWM_TBCLK_HZ) /
                       (uint64_t)ECAP_TSCTR_HZ);
}

static uint32_t wrap_u32(int32_t value, uint32_t modulo)
{
    int32_t m = (int32_t)modulo;
    int32_t r = value % m;
    if (r < 0)
    {
        r += m;
    }
    return (uint32_t)r;
}

static int32_t signed_phase_error(uint32_t actual, uint32_t target, uint32_t modulo)
{
    int32_t err = (int32_t)actual - (int32_t)target;
    int32_t half = (int32_t)(modulo / 2U);

    if (err > half)
    {
        err -= (int32_t)modulo;
    }
    else if (err < -half)
    {
        err += (int32_t)modulo;
    }
    return err;
}

static int32_t clamp_i32(int32_t value, int32_t minValue, int32_t maxValue)
{
    if (value > maxValue)
    {
        return maxValue;
    }
    if (value < minValue)
    {
        return minValue;
    }
    return value;
}




static void PWM_SlaveSync_ConfigPpsRoute(void)
{
    GPIO_setQualificationMode(PPS_GPIO, GPIO_QUAL_ASYNC);
    XBAR_setInputPin(INPUTXBAR_BASE, PPS_INPUT_XBAR, PPS_GPIO);
    XBAR_clearInputFlag(PPS_INPUT_XBAR_FLAG);

    EPWM_setSyncInPulseSource(EPWM1_BASE,
                              EPWM_SYNC_IN_PULSE_SRC_INPUTXBAR_OUT5);
    EPWM_setPhaseShift(EPWM1_BASE, 0U);
    EPWM_enablePhaseShiftLoad(EPWM1_BASE);
    EPWM_setCountModeAfterSync(EPWM1_BASE, EPWM_COUNT_MODE_UP_AFTER_SYNC);

    EPWM_enableSyncOutPulseSource(EPWM1_BASE,
                                  EPWM_SYNC_OUT_PULSE_ON_CNTR_ZERO |
                                  EPWM_SYNC_OUT_PULSE_ON_SOFTWARE);
    SysCtl_setSyncOutputConfig(SYSCTL_SYNC_OUT_SRC_EPWM1SYNCOUT);
}

static void PWM_SlaveSync_ConfigEcap(void)
{
    ECAP_disableInterrupt(PPS_ECAP_BASE, PPS_ECAP_ALL_FLAGS);
    ECAP_clearInterrupt(PPS_ECAP_BASE, PPS_ECAP_ALL_FLAGS);
    ECAP_clearGlobalInterrupt(PPS_ECAP_BASE);

    ECAP_stopCounter(PPS_ECAP_BASE);
    ECAP_enableCaptureMode(PPS_ECAP_BASE);
    ECAP_selectECAPInput(PPS_ECAP_BASE, PPS_ECAP_INPUT);
    ECAP_setCaptureMode(PPS_ECAP_BASE,
                        ECAP_CONTINUOUS_CAPTURE_MODE,
                        ECAP_EVENT_1);
    ECAP_setEventPolarity(PPS_ECAP_BASE,
                          ECAP_EVENT_1,
                          ECAP_EVNT_RISING_EDGE);
    ECAP_enableCounterResetOnEvent(PPS_ECAP_BASE, ECAP_EVENT_1);
    ECAP_enableTimeStampCapture(PPS_ECAP_BASE);
    ECAP_resetCounters(PPS_ECAP_BASE);

    ECAP_enableInterrupt(PPS_ECAP_BASE, ECAP_ISR_SOURCE_CAPTURE_EVENT_1);
    ECAP_startCounter(PPS_ECAP_BASE);
}

void PWM_SlaveSync_Init(void)
{
    PWM_SlaveSync_ConfigPpsRoute();

    Interrupt_register(PPS_ECAP_INT, &PPS_Slave_ISR);
    PWM_SlaveSync_ConfigEcap();
    Interrupt_enable(PPS_ECAP_INT);
}

__interrupt void PPS_Slave_ISR(void)
{
    if((ECAP_getInterruptSource(PPS_ECAP_BASE) &
        ECAP_ISR_SOURCE_CAPTURE_EVENT_1) != 0U)
    {
        g_slavePpsCap1 = ECAP_getEventTimeStamp(PPS_ECAP_BASE,
                                                ECAP_EVENT_1);
        g_slavePpsIsrCount++;
    }

    ECAP_clearInterrupt(PPS_ECAP_BASE, PPS_ECAP_ALL_FLAGS);
    ECAP_clearGlobalInterrupt(PPS_ECAP_BASE);
    Interrupt_clearACKGroup(PPS_ECAP_ACK_GROUP);
}
