void ptp_master_run()
{
    uint32_t timeSec;
    uint32_t timeNanosec;
    uint32_t timeout = 0;
    const uint32_t TIMEOUT_MAX = 2000000;

    // 使用局部变量，不依赖结构体定义
    static uint16_t sequenceId = 0;  // 静态变量保持序列号状态
    uint32_t syncTxSec, syncTxNanosec;  // SYNC发送时间戳 T1

    // 1. 等待1秒PPS定时
    Ethernet_getSysTimePTP(EMAC_BASE, &timeSec, &timeNanosec);
    Ethernet_setTargetTimePPS(EMAC_BASE, ETHERNET_MAC_PPS_OUT_INSTANCE_0,
                              timeSec + 1, timeNanosec);

    while((((HWREG(EMAC_BASE + ETHERNET_O_MAC_TIMESTAMP_STATUS)) &
         (ETHERNET_MAC_TIMESTAMP_STATUS_TSTARGT0)) == 0) &&
         (timeout < TIMEOUT_MAX))
    {
        timeout++;
    }

    if(timeout >= TIMEOUT_MAX)
    {
        CmIpc_cm2cpu.IpcCpu2Cm_Fault = 1;
        return;
    }

    // ========== 发送 SYNC 报文 ==========
    sequenceId++;  // 递增序列号（SYNC和FOLLOW_UP必须相同）[^36^][^37^]

    // 构造 SYNC 报文，传入序列号
    // 假设 sendMessage 会设置报文中的 sequenceId 字段
    sendMessage((Octet *)gMsgBuf, SYNC, &gPtpMasterState, &gPktDesc);

    // 【关键】触发硬件实际发送 - 假设的函数，根据你的硬件调整
    // 例如：Ethernet_sendPacket(EMAC_BASE, gMsgBuf, packetLength);

    // 【关键】获取SYNC的硬件发送时间戳 T1（Two-Step模式必需）[^1^]
    // 方案1：如果硬件支持从描述符读取
    if (Ethernet_getTxTimestamp(EMAC_BASE, &syncTxSec, &syncTxNanosec) == SUCCESS)
    {
        // 成功获取硬件时间戳
    }
    else
    {
        // 方案2：你的硬件不支持TX时间戳，使用软件估计（精度较低）
        Ethernet_getSysTimePTP(EMAC_BASE, &syncTxSec, &syncTxNanosec);
    }

    // ========== 发送 FOLLOW_UP 报文 ==========
    // 【关键】FOLLOW_UP必须包含SYNC的精确发送时间 T1[^1^]
    // 将 T1 写入 FOLLOW_UP 报文的 preciseOriginTimestamp 字段

    // PTP报文格式：preciseOriginTimestamp 在 FOLLOW_UP 中偏移约 34 字节
    // 结构：seconds (6 bytes, 48位) + nanoseconds (4 bytes, 32位)，大端序
    uint8_t *msg = (uint8_t *)gMsgBuf;

    // 清零时间戳区域（假设偏移34字节，根据实际报文头调整）
    memset(&msg[34], 0, 10);

    // 写入秒（48位，6字节，大端序）
    msg[34] = (syncTxSec >> 40) & 0xFF;
    msg[35] = (syncTxSec >> 32) & 0xFF;
    msg[36] = (syncTxSec >> 24) & 0xFF;
    msg[37] = (syncTxSec >> 16) & 0xFF;
    msg[38] = (syncTxSec >> 8) & 0xFF;
    msg[39] = syncTxSec & 0xFF;

    // 写入纳秒（32位，4字节，大端序）
    msg[40] = (syncTxNanosec >> 24) & 0xFF;
    msg[41] = (syncTxNanosec >> 16) & 0xFF;
    msg[42] = (syncTxNanosec >> 8) & 0xFF;
    msg[43] = syncTxNanosec & 0xFF;

    // 构造 FOLLOW_UP 报文（使用与SYNC相同的sequenceId）
    sendMessage((Octet *)gMsgBuf, FOLLOW_UP, &gPtpMasterState, &gPktDesc);

    // 【关键】触发硬件实际发送 FOLLOW_UP
    // 例如：Ethernet_sendPacket(EMAC_BASE, gMsgBuf, packetLength);
}

void InitConstants(PTPMasterState *ptpMasterState)
{
    uint32_t mac_low,mac_high, i, j;
    uint8_t *pucTemp;

    Ethernet_getMACAddr(EMAC_BASE, 0, &mac_high, &mac_low);

    pucTemp = (uint8_t *)&mac_low;
    ptpMasterState->port_uuid_field[0] = pucTemp[0];
    ptpMasterState->port_uuid_field[1] = pucTemp[1];
    ptpMasterState->port_uuid_field[2] = pucTemp[2];
    ptpMasterState->port_uuid_field[3] = pucTemp[3];

    pucTemp = (uint8_t *)&mac_high;
    ptpMasterState->port_uuid_field[4] = pucTemp[0];
    ptpMasterState->port_uuid_field[5] = pucTemp[1];

    // Init global constants.
    for (i = 0, j = 0; i < CLOCK_IDENTITY_LENGTH; i++)
    {
       if (i == 3) ptpMasterState->portIdentity.clockIdentity[i] = 0xFF;
       else if (i == 4) ptpMasterState->portIdentity.clockIdentity[i] = 0xFE;
       else
       {
           ptpMasterState->portIdentity.clockIdentity[i] =
                   ptpMasterState->port_uuid_field[j];
           j++;
       }
    }
}

