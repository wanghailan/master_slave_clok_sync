void ptp_master_run()
{
    uint32_t timeSec;
    uint32_t timeNanosec;
    uint32_t timeout = 0;
    const uint32_t TIMEOUT_MAX = 2000000;
    uint32_t syncTxSec, syncTxNanosec;  // 保存 SYNC 发送时间 T1

    // 1. 等待1秒PPS定时（与PPS信号对齐，确保周期性发送）
    Ethernet_getSysTimePTP(EMAC_BASE, &timeSec, &timeNanosec);
    Ethernet_setTargetTimePPS(EMAC_BASE, ETHERNET_MAC_PPS_OUT_INSTANCE_0,
                              timeSec + 1, timeNanosec);

    while((((HWREG(EMAC_BASE + ETHERNET_O_MAC_TIMESTAMP_STATUS)) &
         (ETHERNET_MAC_TIMESTAMP_STATUS_TSTARGT0)) == 0) &&
         (timeout < TIMEOUT_MAX))
    {
        timeout++;
    }

    if(timeout >= TIMEOUT_MAX)
    {
        CmIpc_cm2cpu.IpcCpu2Cm_Fault = 1;
        return;
    }

    // ========== 发送 SYNC 报文 ==========
    // 1. 构造 SYNC 报文（Two-Step 模式：SYNC 中 T1 为0或估计值，精确值在 FOLLOW_UP 中）
    gPtpMasterState.sentSeqId++;

    // 设置发送描述符，启用硬件时间戳捕获
    // 假设 gPktDesc 包含发送描述符配置，需要设置 TX 时间戳使能位
    gPktDesc.ptpMsgType = SYNC;
    gPktDesc.ptpSequenceId = gPtpMasterState.sentSeqId;
    gPktDesc.timestampEnable = 1;  // 启用硬件 TX 时间戳

    // 2. 将报文放入发送队列并触发硬件发送
    // 假设 sendMessage 只构造报文，需要额外触发发送
    sendMessage((Octet *)gMsgBuf, SYNC, &gPtpMasterState, &gPktDesc);

    // 3. 触发 EMAC 硬件发送（关键缺失步骤！）
    // 具体寄存器取决于你的 EMAC 硬件，例如：
    // HWREG(EMAC_BASE + ETHERNET_O_DMA_TX_POLL_DEMAND) = 1;
    Ethernet_triggerTx(EMAC_BASE, &gPktDesc);  // 触发实际发送

    // 4. 获取 SYNC 的硬件 TX 时间戳 T1（Two-Step 模式核心）
    // 方案 A：如果硬件支持 TX 完成中断（理想情况）
    // 等待 TX 完成标志，然后从描述符读取时间戳
    if (Ethernet_getTxTimestamp(EMAC_BASE, &gPktDesc, &syncTxSec, &syncTxNanosec) == SUCCESS)
    {
        // 成功获取 T1
        gPtpMasterState.syncTxSec = syncTxSec;
        gPtpMasterState.syncTxNanosec = syncTxNanosec;
    }
    else
    {
        // 方案 B：如果硬件不支持 TX 时间戳（你的注释提到的情况）
        // 使用软件估计时间（精度较低，但只能如此）
        Ethernet_getSysTimePTP(EMAC_BASE, &gPtpMasterState.syncTxSec,
                               &gPtpMasterState.syncTxNanosec);
    }

    // ========== 发送 FOLLOW_UP 报文 ==========
    // 1. 构造 FOLLOW_UP 报文，包含精确的 T1 时间戳
    // FOLLOW_UP 必须携带 SYNC 的实际发送时间（t1）[^1^][^14^]
    gPktDesc.ptpMsgType = FOLLOW_UP;
    gPktDesc.ptpSequenceId = gPtpMasterState.sentSeqId;  // 必须与 SYNC 相同序列号！[^8^][^9^]
    gPktDesc.timestampEnable = 0;  // FOLLOW_UP 不需要硬件时间戳

    // 2. 将 T1 写入 FOLLOW_UP 报文的 preciseOriginTimestamp 字段
    // PTP 报文格式：preciseOriginTimestamp 在 FOLLOW_UP 中偏移约 34 字节
    // 结构：seconds (6 bytes) + nanoseconds (4 bytes)
    uint8_t *followUpMsg = (uint8_t *)gMsgBuf;

    // 清空时间戳字段区域（假设偏移量为34，根据实际报文结构调整）
    memset(&followUpMsg[34], 0, 10);

    // 写入秒（48位，6字节，大端序）
    followUpMsg[34] = (gPtpMasterState.syncTxSec >> 40) & 0xFF;
    followUpMsg[35] = (gPtpMasterState.syncTxSec >> 32) & 0xFF;
    followUpMsg[36] = (gPtpMasterState.syncTxSec >> 24) & 0xFF;
    followUpMsg[37] = (gPtpMasterState.syncTxSec >> 16) & 0xFF;
    followUpMsg[38] = (gPtpMasterState.syncTxSec >> 8) & 0xFF;
    followUpMsg[39] = gPtpMasterState.syncTxSec & 0xFF;

    // 写入纳秒（32位，4字节，大端序）
    followUpMsg[40] = (gPtpMasterState.syncTxNanosec >> 24) & 0xFF;
    followUpMsg[41] = (gPtpMasterState.syncTxNanosec >> 16) & 0xFF;
    followUpMsg[42] = (gPtpMasterState.syncTxNanosec >> 8) & 0xFF;
    followUpMsg[43] = gPtpMasterState.syncTxNanosec & 0xFF;

    // 3. 发送 FOLLOW_UP（不需要等待，但建议短暂延迟确保 SYNC 先发出）
    // 实际应用中可能需要检查 SYNC 是否已完全发出
    sendMessage((Octet *)gMsgBuf, FOLLOW_UP, &gPtpMasterState, &gPktDesc);
    Ethernet_triggerTx(EMAC_BASE, &gPktDesc);  // 触发实际发送
}

void InitConstants(PTPMasterState *ptpMasterState)
{
    uint32_t mac_low,mac_high, i, j;
    uint8_t *pucTemp;

    Ethernet_getMACAddr(EMAC_BASE, 0, &mac_high, &mac_low);

    pucTemp = (uint8_t *)&mac_low;
    ptpMasterState->port_uuid_field[0] = pucTemp[0];
    ptpMasterState->port_uuid_field[1] = pucTemp[1];
    ptpMasterState->port_uuid_field[2] = pucTemp[2];
    ptpMasterState->port_uuid_field[3] = pucTemp[3];

    pucTemp = (uint8_t *)&mac_high;
    ptpMasterState->port_uuid_field[4] = pucTemp[0];
    ptpMasterState->port_uuid_field[5] = pucTemp[1];

    // Init global constants.
    for (i = 0, j = 0; i < CLOCK_IDENTITY_LENGTH; i++)
    {
       if (i == 3) ptpMasterState->portIdentity.clockIdentity[i] = 0xFF;
       else if (i == 4) ptpMasterState->portIdentity.clockIdentity[i] = 0xFE;
       else
       {
           ptpMasterState->portIdentity.clockIdentity[i] =
                   ptpMasterState->port_uuid_field[j];
           j++;
       }
    }
}

