/*
 * pwm_slave_sync.c
 *
 * 功能：
 *    Slave侧PPS同步PWM。
 *    通过eCAP1捕获经PTP协议同步后的PPS上升沿，
 *    在确认PTP已锁定（Cpu1Ipc_cm2cpu.PtpSynced==1）后，
 *    校正EPWM1相位，使其与Master的PWM间接对齐。
 */

#include "pwm_slave_sync.h"
#include "bsp.h"


#define PPS_INPUTXBAR_CHANNEL       XBAR_INPUT7            // 内部路由(AUXSIG2 -> INPUTXBAR7)
#define PPS_ECAP_INPUT_SEL          ECAP_INPUT_INPUTXBAR7  // INPUTXBAR7 -> ECAP1




volatile uint32_t g_slavePpsIsrCount = 0U;
volatile uint32_t g_slavePpsCap1 = 0U;

static void PWM_SlaveSync_ConfigPpsRoute(void)
{
    GPIO_setQualificationMode(PPS_GPIO, GPIO_QUAL_ASYNC);
    XBAR_setInputPin(INPUTXBAR_BASE, PPS_INPUT_XBAR, PPS_GPIO);
    XBAR_clearInputFlag(PPS_INPUT_XBAR_FLAG);

    EPWM_setSyncInPulseSource(EPWM1_BASE,
                              EPWM_SYNC_IN_PULSE_SRC_INPUTXBAR_OUT5);
    EPWM_setPhaseShift(EPWM1_BASE, 0U);
    EPWM_enablePhaseShiftLoad(EPWM1_BASE);
    EPWM_setCountModeAfterSync(EPWM1_BASE, EPWM_COUNT_MODE_UP_AFTER_SYNC);

    EPWM_enableSyncOutPulseSource(EPWM1_BASE,
                                  EPWM_SYNC_OUT_PULSE_ON_CNTR_ZERO |
                                  EPWM_SYNC_OUT_PULSE_ON_SOFTWARE);
    SysCtl_setSyncOutputConfig(SYSCTL_SYNC_OUT_SRC_EPWM1SYNCOUT);
}

static void PWM_SlaveSync_ConfigEcap(void)
{
    ECAP_disableInterrupt(PPS_ECAP_BASE, PPS_ECAP_ALL_FLAGS);
    ECAP_clearInterrupt(PPS_ECAP_BASE, PPS_ECAP_ALL_FLAGS);
    ECAP_clearGlobalInterrupt(PPS_ECAP_BASE);

    ECAP_stopCounter(PPS_ECAP_BASE);
    ECAP_enableCaptureMode(PPS_ECAP_BASE);
    ECAP_selectECAPInput(PPS_ECAP_BASE, PPS_ECAP_INPUT);
    ECAP_setCaptureMode(PPS_ECAP_BASE,
                        ECAP_CONTINUOUS_CAPTURE_MODE,
                        ECAP_EVENT_1);
    ECAP_setEventPolarity(PPS_ECAP_BASE,
                          ECAP_EVENT_1,
                          ECAP_EVNT_RISING_EDGE);
    ECAP_enableCounterResetOnEvent(PPS_ECAP_BASE, ECAP_EVENT_1);
    ECAP_enableTimeStampCapture(PPS_ECAP_BASE);
    ECAP_resetCounters(PPS_ECAP_BASE);

    ECAP_enableInterrupt(PPS_ECAP_BASE, ECAP_ISR_SOURCE_CAPTURE_EVENT_1);
    ECAP_startCounter(PPS_ECAP_BASE);
}

void PWM_SlaveSync_Init(void)
{
    PWM_SlaveSync_ConfigPpsRoute();

    Interrupt_register(PPS_ECAP_INT, &PPS_Slave_ISR);
    PWM_SlaveSync_ConfigEcap();
    Interrupt_enable(PPS_ECAP_INT);
}

__interrupt void PPS_Slave_ISR(void)
{
    if((ECAP_getInterruptSource(PPS_ECAP_BASE) &
        ECAP_ISR_SOURCE_CAPTURE_EVENT_1) != 0U)
    {
        g_slavePpsCap1 = ECAP_getEventTimeStamp(PPS_ECAP_BASE,
                                                ECAP_EVENT_1);
        g_slavePpsIsrCount++;
    }

    ECAP_clearInterrupt(PPS_ECAP_BASE, PPS_ECAP_ALL_FLAGS);
    ECAP_clearGlobalInterrupt(PPS_ECAP_BASE);
    Interrupt_clearACKGroup(PPS_ECAP_ACK_GROUP);
}
