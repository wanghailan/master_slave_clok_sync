//
// function definitions
//
__attribute__((interrupt))  void Cla1Task1 ( void )
{
    tCla2Cpu.PcsDebugi16_0++;
    if(tCla2Cpu.PcsDebugi16_0 > 32000)
        tCla2Cpu.PcsDebugi16_0 = 0;
    tCla2Cpu.PcsDebugi16_1++;
    tCla2Cpu.PcsDebugi16_2 = tCla2Cpu.PcsDebugi16_1-200;//CLAisqrt(tCla2Cpu.PcsDebugi16_1);
    if(tCla2Cpu.PcsDebugi16_1 > 32000)
        tCla2Cpu.PcsDebugi16_1 = 0;
    //读AD转换结果,并标幺
    PCS_CLA_AdSignalsRead();
    //ABC变换到DQ
    PCS_CLA_RunTransform();
    PCS_CLA_RealTimeData();

    if(tCpu2Cla.PwmStartEnable)
    {
        if(tCpu2Cla.OpenLoopMode == 0)//开环
        {
            tClaPrivate.Pcs_UirD = tClaPrivate.Pcs_VinvMdRef;
            tClaPrivate.Pcs_UirQ = 0.0f;
            tClaPrivate.Pcs_UirZ = 0.0f;
        }
        else //闭环
        {
            if(tCpu2Cla.WorkMode == CLA_GRID_DISCONNECTED)//离网
            {
                PCS_CLA_Int_OffGrid();
            }
            else if(tCpu2Cla.WorkMode == CLA_GRID_CONNECTED)//并网
            {
                PCS_CLA_Int_OnGrid();
            }
        }
        tClaPrivate.Pwm_Enable = 1;
    }
    else
    {
        PCS_CLA_PWMOff();
        tClaPrivate.Pwm_Enable = 0;
    }
    PCS_Int_PwmCtrl(tClaPrivate.Pwm_Enable);
}

