void Pcs_Int_PQCtrlReg(void)
{
 //   if(tClaPrivate.Pcs_PacRef > 0.0f)//给定功率大于0，电流从直流到交流
    {
        float32_t div_param;
        div_param = 0.666666667f/(tClaPrivate.Pcs_VinvMd*tClaPrivate.Pcs_VinvMd+tClaPrivate.Pcs_VinvMq*tClaPrivate.Pcs_VinvMq);
        tClaPrivate.Pcs_IinvMdRef_1 = (tClaPrivate.Pcs_PacRef*tClaPrivate.Pcs_VinvMd-tClaPrivate.Pcs_QacRef*tClaPrivate.Pcs_VinvMq)*div_param;
        tClaPrivate.Pcs_IinvMqRef_1 = (tClaPrivate.Pcs_PacRef*tClaPrivate.Pcs_VinvMq-tClaPrivate.Pcs_QacRef*tClaPrivate.Pcs_VinvMd)*div_param;
        tClaPrivate.Pcs_IinvMzRef_1 = 0.0f;
    }
//    else //给定功率小于0，电流从交流到直流
//    {
//        tClaPrivate.Pcs_ErrorVinvMd      = tClaPrivate.Pcs_IdcRef - tClaPrivate.Pcs_iBus_DC;
//     //   tClaPrivate.Pcs_ErrorVinvMd      = satF32(tClaPrivate.Pcs_ErrorVinvMd,-2.0f,2.0f);
//        tClaPrivate.Pcs_VinvDRegOut      = tClaPrivate.Pcs_ErrorVinvMd * tClaPrivate.Pcs_Kp_Idc + tClaPrivate.Pcs_VinvDRegIOut;
//        tClaPrivate.Pcs_VinvDRegOut      = satF32(tClaPrivate.Pcs_VinvDRegOut, INV3P_VDREGOUTLIM_N,INV3P_VDREGOUTLIM_P);
//        tClaPrivate.Pcs_VinvDRegIOut    += tClaPrivate.Pcs_ErrorVinvMd * tClaPrivate.Pcs_Ki_Idc;
//        tClaPrivate.Pcs_VinvDRegIOut     = satF32(tClaPrivate.Pcs_VinvDRegIOut,INV3P_VDREGOUTLIM_N,INV3P_VDREGOUTLIM_P);
//
//        tClaPrivate.Pcs_IinvMdRef        = tClaPrivate.Pcs_VinvDRegOut;
//        tClaPrivate.Pcs_IinvMqRef        = 0.0f;
//        tClaPrivate.Pcs_IinvMzRef        = 0.0f;
//
//        tClaPrivate.Pcs_IinvMdRef_1      = tClaPrivate.Pcs_IinvMdRef;
//        tClaPrivate.Pcs_IinvMqRef_1      = tClaPrivate.Pcs_IinvMqRef;
//        tClaPrivate.Pcs_IinvMzRef_1      = tClaPrivate.Pcs_IinvMzRef;
//    }
}

void Pcs_Int_ACCurrCtrlReg(void)
{ //正电池放电，负电池充电
    tClaPrivate.Pcs_IinvMdRef_1 = tClaPrivate.Pcs_ACIoutRef;
    tClaPrivate.Pcs_IinvMqRef_1 = 0.0f;
    tClaPrivate.Pcs_IinvMzRef_1 = 0.0f;
}

//并网恒直流电压模式,直流源模式
void PCS_Int_DCVolReg(void)
{
//直流电压环

   tClaPrivate.Pcs_ErrorVinvMd      = tClaPrivate.Pcs_vBus_DC - tClaPrivate.Pcs_VdcRef;
//       tClaPrivate.Pcs_ErrorVinvMd      = satF32(tClaPrivate.Pcs_ErrorVinvMd,-2.0f,2.0f);
   tClaPrivate.Pcs_VinvDRegOut      = tClaPrivate.Pcs_ErrorVinvMd * tClaPrivate.Pcs_Kp_Udc + tClaPrivate.Pcs_VinvDRegIOut;
   tClaPrivate.Pcs_VinvDRegOut      = satF32(tClaPrivate.Pcs_VinvDRegOut, (0.0f-tClaPrivate.MaxCurrent)*1.0f,tClaPrivate.MaxCurrent*1.0f);
   tClaPrivate.Pcs_VinvDRegIOut    += tClaPrivate.Pcs_ErrorVinvMd * tClaPrivate.Pcs_Ki_Udc;
   tClaPrivate.Pcs_VinvDRegIOut     = satF32(tClaPrivate.Pcs_VinvDRegIOut,(0.0f-tClaPrivate.MaxCurrent)*1.0f,tClaPrivate.MaxCurrent*1.0f);

   tClaPrivate.Pcs_IinvMdRef        = tClaPrivate.Pcs_VinvDRegOut;
   tClaPrivate.Pcs_IinvMqRef        = 0.0f;
   tClaPrivate.Pcs_IinvMzRef        = 0.0f;

   tClaPrivate.Pcs_IinvMdRef_1      = tClaPrivate.Pcs_IinvMdRef;
   tClaPrivate.Pcs_IinvMqRef_1      = tClaPrivate.Pcs_IinvMqRef;
   tClaPrivate.Pcs_IinvMzRef_1      = tClaPrivate.Pcs_IinvMzRef;
}

//并网直流恒流控制
void PCS_Int_DCCurrReg(void)
{
   tClaPrivate.Pcs_ErrorVinvMd      = tClaPrivate.Pcs_IdcRef - tClaPrivate.Pcs_iBus_DC;
//   tClaPrivate.Pcs_ErrorVinvMd      = satF32(tClaPrivate.Pcs_ErrorVinvMd,-2.0f,2.0f);
   tClaPrivate.Pcs_VinvDRegOut      = tClaPrivate.Pcs_ErrorVinvMd * tClaPrivate.Pcs_Kp_Idc + tClaPrivate.Pcs_VinvDRegIOut;
   tClaPrivate.Pcs_VinvDRegOut      = satF32(tClaPrivate.Pcs_VinvDRegOut, (0.0f-tClaPrivate.MaxCurrent)*1.0f,tClaPrivate.MaxCurrent*1.0f);
   tClaPrivate.Pcs_VinvDRegIOut    += tClaPrivate.Pcs_ErrorVinvMd * tClaPrivate.Pcs_Ki_Idc;
   tClaPrivate.Pcs_VinvDRegIOut     = satF32(tClaPrivate.Pcs_VinvDRegIOut,(0.0f-tClaPrivate.MaxCurrent)*1.0f,tClaPrivate.MaxCurrent*1.0f);

   tClaPrivate.Pcs_IinvMdRef        = tClaPrivate.Pcs_VinvDRegOut;
   tClaPrivate.Pcs_IinvMqRef        = 0.0f;
   tClaPrivate.Pcs_IinvMzRef        = 0.0f;

   tClaPrivate.Pcs_IinvMdRef_1      = tClaPrivate.Pcs_IinvMdRef;
   tClaPrivate.Pcs_IinvMqRef_1      = tClaPrivate.Pcs_IinvMqRef;
   tClaPrivate.Pcs_IinvMzRef_1      = tClaPrivate.Pcs_IinvMzRef;
}

void  PCS_CLA_Int_OffGrid(void)
{
    PCS_Int_InvVolReg();
    PCS_Int_InvCurrReg();
}

void  PCS_CLA_Int_OnGrid(void)
{
    if(tCpu2Cla.OnGridMode==0)//恒功率
        Pcs_Int_PQCtrlReg();
    else if(tCpu2Cla.OnGridMode==1)//恒AC电流
        Pcs_Int_ACCurrCtrlReg();
    else if(tCpu2Cla.OnGridMode==2)//恒直流电压
        PCS_Int_DCVolReg();
    else if(tCpu2Cla.OnGridMode==3)//恒直流电流
        PCS_Int_DCCurrReg();
    PCS_Int_InvCurrReg();
}

void  PCS_Int_PwmCtrl(int16_t _en)
{
    float32_t f32_UirAx_0,f32_UirBx_0,f32_UirCx_0;
    float32_t  Pcs_VoutD_Pwm,Pcs_VoutQ_Pwm,Pcs_VoutZ_Pwm;
    float32_t f32_UirMax_0,f32_UirMin_0,f32_UirZx_0;
    float32_t f32_ctrlLimt;
    float32_t f32_DCBanaceCtrl;

//    if(tCpu2Cla.pcsLineMode == CLA_PHS_OUT_3P3L)
        f32_ctrlLimt = 1.15f;
//    else
//        f32_ctrlLimt = 0.86f;

    if(_en == 1)
    {
        Pcs_VoutD_Pwm = tClaPrivate.Pcs_UirD*2.0f/tClaPrivate.Pcs_vBus_DC;
        Pcs_VoutQ_Pwm = tClaPrivate.Pcs_UirQ*2.0f/tClaPrivate.Pcs_vBus_DC;
        Pcs_VoutZ_Pwm = tClaPrivate.Pcs_UirZ*2.0f/tClaPrivate.Pcs_vBus_DC;

        Pcs_VoutD_Pwm = satF32(Pcs_VoutD_Pwm,0.0f,f32_ctrlLimt);
        Pcs_VoutQ_Pwm = satF32(Pcs_VoutQ_Pwm,0.0f,f32_ctrlLimt);
        Pcs_VoutZ_Pwm = satF32(Pcs_VoutZ_Pwm,0.0f,f32_ctrlLimt);
    }
    else
    {
        Pcs_VoutD_Pwm = 0.0f;
        Pcs_VoutQ_Pwm = 0.0f;
        Pcs_VoutZ_Pwm = 0.0f;
    }
    tCla2Cpu.Pcs_vdRatio_pu  = Pcs_VoutD_Pwm;

    DQ0_ABC_run(&PCS_vInv_dq0, Pcs_VoutD_Pwm, Pcs_VoutQ_Pwm, Pcs_VoutZ_Pwm,
                tClaPrivate.Pcs_SinRef, tClaPrivate.Pcs_CosRef);

    f32_UirAx_0 = PCS_vInv_dq0.a;//-1~1范围
    f32_UirBx_0 = PCS_vInv_dq0.b;
    f32_UirCx_0 = PCS_vInv_dq0.c;


    //直流中点电压平衡控制
    if((tClaPrivate.Pcs_VBusP_pu-tClaPrivate.Pcs_VBusN_pu) > 0.0f)
        f32_DCBanaceCtrl = 0.0125f;
    else
        f32_DCBanaceCtrl = -0.0125f;

    if(tClaPrivate.Pcs_IinvMdRef_1 < 0.0f)
        f32_DCBanaceCtrl *= -1.0f;

//    if(tCpu2Cla.pcsLineMode == CLA_PHS_OUT_3P3L)
    {
        // 注入0序 类SVPWM
        f32_UirMax_0 = __mmaxf32(f32_UirAx_0,f32_UirBx_0);
        f32_UirMax_0 = __mmaxf32(f32_UirMax_0,f32_UirCx_0);
        f32_UirMin_0 = __mminf32(f32_UirAx_0,f32_UirBx_0);
        f32_UirMin_0 = __mminf32(f32_UirMin_0,f32_UirCx_0);
        f32_UirZx_0  = -0.5f*(f32_UirMax_0 + f32_UirMin_0)+ f32_DCBanaceCtrl;

        f32_UirAx_0 += (f32_UirZx_0);
        f32_UirBx_0 += (f32_UirZx_0);
        f32_UirCx_0 += (f32_UirZx_0);

    }

    PCS_CLA_updatePWMDuty(f32_UirAx_0, f32_UirBx_0, f32_UirCx_0,f32_UirZx_0);
}

inline void PCS_CLA_updatePWMDuty(float32_t dutyA,float32_t dutyB,float32_t dutyC,float32_t dutyN)
{
    uint32_t dutyAP_ticks, dutyBP_ticks, dutyCP_ticks, dutyNP_ticks;
    uint32_t dutyAN_ticks, dutyBN_ticks, dutyCN_ticks, dutyNN_ticks;
    float32_t epwm_perid = (float32_t)EPWM_TBPRD;

    if(dutyA > 0)
    {
        if(dutyA > PCS_PWM_MAX_RATIO)
            dutyA = PCS_PWM_MAX_RATIO;
        dutyAP_ticks = (uint32_t)(epwm_perid*dutyA);
        dutyAN_ticks = (uint32_t)(epwm_perid*1.0f);
    }
    else
    {
        if(dutyA < PCS_PWM_MIN_RATIO)
           dutyA = PCS_PWM_MIN_RATIO;
        dutyAP_ticks = (uint32_t)(epwm_perid*0.0f);
        dutyAN_ticks = (uint32_t)(epwm_perid*(dutyA+1.0f));
    }

    if(dutyB > 0)
    {
        if(dutyB > PCS_PWM_MAX_RATIO)
           dutyB = PCS_PWM_MAX_RATIO;
        dutyBP_ticks = (uint32_t)(epwm_perid*dutyB);
        dutyBN_ticks = (uint32_t)(epwm_perid*1.0f);
    }
    else
    {
        if(dutyB < PCS_PWM_MIN_RATIO)
           dutyB = PCS_PWM_MIN_RATIO;
        dutyBP_ticks = (uint32_t)(epwm_perid*0.0f);
        dutyBN_ticks = (uint32_t)(epwm_perid*(dutyB+1.0f));
    }

    if(dutyC > 0)
    {
        if(dutyC > PCS_PWM_MAX_RATIO)
           dutyC = PCS_PWM_MAX_RATIO;
        dutyCP_ticks = (uint32_t)(epwm_perid*dutyC);
        dutyCN_ticks = (uint32_t)(epwm_perid*1.0f);
    }
    else
    {
        if(dutyC < PCS_PWM_MIN_RATIO)
           dutyC = PCS_PWM_MIN_RATIO;
        dutyCP_ticks = (uint32_t)(epwm_perid*0.0f);
        dutyCN_ticks = (uint32_t)(epwm_perid*(dutyC+1.0f));
    }
	
    if(tCpu2Cla.pcsLineMode == CLA_PHS_OUT_3P4L)
    {
        if(dutyN > 0)
        {
            if(dutyN > PCS_PWM_MAX_RATIO)
                dutyN = PCS_PWM_MAX_RATIO;
            dutyNP_ticks = (uint32_t)(epwm_perid*dutyN);
            dutyNN_ticks = (uint32_t)(epwm_perid*1.0f);
        }
        else
        {
            if(dutyN < PCS_PWM_MIN_RATIO)
                dutyN = PCS_PWM_MIN_RATIO;
            dutyNP_ticks = (uint32_t)(epwm_perid*0.0f);
            dutyNN_ticks = (uint32_t)(epwm_perid*(dutyN+1.0f));
        }
    }
    
//    dutyAP_ticks = PWM_Limit(dutyAP_ticks,EPWM_MIN,EPWM_TBPRD);
//    dutyAN_ticks = PWM_Limit(dutyAN_ticks,EPWM_MIN,EPWM_TBPRD);
//    dutyBP_ticks = PWM_Limit(dutyBP_ticks,EPWM_MIN,EPWM_TBPRD);
//    dutyBN_ticks = PWM_Limit(dutyBN_ticks,EPWM_MIN,EPWM_TBPRD);
//    dutyCP_ticks = PWM_Limit(dutyCP_ticks,EPWM_MIN,EPWM_TBPRD);
//    dutyCN_ticks = PWM_Limit(dutyCN_ticks,EPWM_MIN,EPWM_TBPRD);
#if PWM_SYNC_TEST_MODE
    dutyAP_ticks = (uint32_t)(epwm_perid * 0.5f);
#endif
    //
    // Set PWM outputs
    EPWM_setCounterCompareValue(PCS_Q1_Q3_A_PWM_BASE,EPWM_COUNTER_COMPARE_A,dutyAP_ticks);
    EPWM_setCounterCompareValue(PCS_Q2_Q4_A_PWM_BASE,EPWM_COUNTER_COMPARE_A,dutyAN_ticks);

    EPWM_setCounterCompareValue(PCS_Q1_Q3_B_PWM_BASE,EPWM_COUNTER_COMPARE_A,dutyBP_ticks);
    EPWM_setCounterCompareValue(PCS_Q2_Q4_B_PWM_BASE,EPWM_COUNTER_COMPARE_A,dutyBN_ticks);

    EPWM_setCounterCompareValue(PCS_Q1_Q3_C_PWM_BASE,EPWM_COUNTER_COMPARE_A,dutyCP_ticks);
    EPWM_setCounterCompareValue(PCS_Q2_Q4_C_PWM_BASE,EPWM_COUNTER_COMPARE_A,dutyCN_ticks);
    if(tCpu2Cla.pcsLineMode == CLA_PHS_OUT_3P4L)
    {
        EPWM_setCounterCompareValue(PCS_Q1_Q2_N_PWM_BASE,EPWM_COUNTER_COMPARE_A,dutyNP_ticks);
        EPWM_setCounterCompareValue(PCS_Q1_Q2_N_PWM_BASE,EPWM_COUNTER_COMPARE_B,dutyNN_ticks);
    }
}

void PCS_CLA_PWMOff(void)
{
//    GPIO_writePin(97, 1);

    tClaPrivate.Pcs_VinvDRegIOut  = 0.0f;
    tClaPrivate.Pcs_VinvQRegIOut  = 0.0f;
    tClaPrivate.Pcs_VinvZRegIOut  = 0.0f;
    tClaPrivate.Pcs_VinvDRegIOut_N  = 0.0f;
    tClaPrivate.Pcs_VinvQRegIOut_N  = 0.0f;

    tClaPrivate.Pcs_IlDRegIOut  = 0.0f;
    tClaPrivate.Pcs_IlQRegIOut  = 0.0f;
    tClaPrivate.Pcs_IlZRegIOut  = 0.0f;
    tClaPrivate.Pcs_ErrorIlMd_old = 0.0f;
    tClaPrivate.Pcs_ErrorIlMq_old = 0.0f;

    tClaPrivate.Pcs_VinvMdRef = 0.0f;

}



float32_t satF32(float32_t input,float32_t min,float32_t max)
{
    float32_t output;

    output = __mminf32(input,max);
    output = __mmaxf32(output,min);

    return output;
}

/*一阶低通滤波器*/
float32_t order1_lowFliter(float32_t xin,uint16_t flag)//0是电压；1是电流；3是p母线电压；4是n母线电压
{
    float32_t lpFilter_Yn;
    if(flag==0)
    {
        lpFilter_Yn = lFilter_a*xin + (1-lFilter_a)*tClaPrivate.lpFilter_Yn_l;
        tClaPrivate.lpFilter_Yn_l = lpFilter_Yn;
    }
    if(flag==1)
    {
        lpFilter_Yn = lFilter_a*xin + (1-lFilter_a)*tClaPrivate.lpFilter_Yn_V;
        tClaPrivate.lpFilter_Yn_V = lpFilter_Yn;
    }
    if(flag==2)
    {
        lpFilter_Yn = lFilter_a*xin + (1-lFilter_a)*tClaPrivate.lpFilter_Yn_BPV;
        tClaPrivate.lpFilter_Yn_BPV = lpFilter_Yn;
    }
    if(flag==3)
    {
        lpFilter_Yn = lFilter_a*xin + (1-lFilter_a)*tClaPrivate.lpFilter_Yn_BNV;
        tClaPrivate.lpFilter_Yn_BNV = lpFilter_Yn;
    }
    return lpFilter_Yn;
}

uint32_t PWM_Limit(uint32_t Pwm_set,uint32_t Pwm_min,uint32_t Pwm_max)
{
    uint32_t temp_Data;

    if (Pwm_set < Pwm_min)
        temp_Data = 0;
    else if (Pwm_set < (Pwm_max-Pwm_min))
        temp_Data = Pwm_set;
    else
        temp_Data = Pwm_max;

    return temp_Data;
}
