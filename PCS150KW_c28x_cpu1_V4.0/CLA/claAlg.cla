void PCS_CLA_ParamInit(void)
{
    tCla2Cpu.PcsDebugi16_0 = 0;
    tCla2Cpu.PcsDebugi16_1 = 0;
    tClaPrivate.Pwm_Enable = 0;
    DQ0_ABC_reset(&(PCS_vInv_dq0));
    ABC_DQ0_POS_reset(&PCS_iGrid_dq0_pos);
    ABC_DQ0_POS_reset(&PCS_iInv_dq0_pos);
    clarkT_reset(&PCS_vGrid_Clark);
    ParkT_reset(&PCS_vGrid_Park_p);
    ParkT_reset(&PCS_vGrid_Park_n);


    /* initialise PI controller */
    //交流稳压外环
    tClaPrivate.Pcs_VinvKp = INV3P_VINV_KP;
    tClaPrivate.Pcs_VinvKi = INV3P_VINV_KI;
    //直流稳压外环
    tClaPrivate.Pcs_Kp_Udc = INV3P_VINV_KP;
    tClaPrivate.Pcs_Ki_Udc = INV3P_VINV_KI;
    //恒直流电流外环
    tClaPrivate.Pcs_Kp_Idc = INV3P_IDC_KP;
    tClaPrivate.Pcs_Ki_Idc = INV3P_IDC_KI;
    //电感电流内环
    tClaPrivate.Pcs_IlKp   = INV3P_IINV_KP;
    tClaPrivate.Pcs_IlKi   = INV3P_IINV_KI;

    tClaPrivate.Pcs_VinvDRegIOut  = 0.0f;
    tClaPrivate.Pcs_VinvQRegIOut  = 0.0f;
    tClaPrivate.Pcs_VinvZRegIOut  = 0.0f;
    tClaPrivate.Pcs_VinvDRegIOut_N  = 0.0f;
    tClaPrivate.Pcs_VinvQRegIOut_N  = 0.0f;

    tClaPrivate.Pcs_IlDRegIOut  = 0.0f;
    tClaPrivate.Pcs_IlQRegIOut  = 0.0f;
    tClaPrivate.Pcs_IlZRegIOut  = 0.0f;
    tClaPrivate.Pcs_ErrorIlMd_old = 0.0f;
    tClaPrivate.Pcs_ErrorIlMq_old = 0.0f;

    tClaPrivate.lpFilter_Yn_l  = 0.0f;
    tClaPrivate.lpFilter_Yn_V  = 0.0f;
}

float32_t PCS_CLA_Ad2Pu(int16_t type,uint16_t AdCh,float32_t offset)
{
    float32_t Temp;

    Temp = (float32_t)AdCh * PCS_ADC_PU_SCALE_FACTOR;
    if(type == 0)//有偏置
        Temp = Temp - PCS_OFFSET_PU*tCpu2Cla.Ref1v5_Calibrat*offset;

    return Temp;
}

void PCS_CLA_AdSignalsRead(void)
{
    //输出电流
    tClaPrivate.Pcs_iGrid_A_sensed_pu = PCS_CLA_Ad2Pu(0,PCS_IGRID_A_READ_AD,tCpu2Cla.Iac_Aoffset)*2.0f*tCpu2Cla.IGridA_Calibrat;//反向接,采样取反
    tClaPrivate.Pcs_iGrid_B_sensed_pu = PCS_CLA_Ad2Pu(0,PCS_IGRID_B_READ_AD,tCpu2Cla.Iac_Boffset)*2.0f*tCpu2Cla.IGridB_Calibrat;
    tClaPrivate.Pcs_iGrid_C_sensed_pu = PCS_CLA_Ad2Pu(0,PCS_IGRID_C_READ_AD,tCpu2Cla.Iac_Coffset)*2.0f*tCpu2Cla.IGridC_Calibrat;
    //逆变电流
    tClaPrivate.Pcs_iInv_A_sensed_pu  =  PCS_CLA_Ad2Pu(0,PCS_IINV_A_READ_AD,tCpu2Cla.Ilac_Aoffset)*2.0f*tCpu2Cla.IInvA_Calibrat;
    tClaPrivate.Pcs_iInv_B_sensed_pu  =  PCS_CLA_Ad2Pu(0,PCS_IINV_B_READ_AD,tCpu2Cla.Ilac_Boffset)*2.0f*tCpu2Cla.IInvB_Calibrat;
    tClaPrivate.Pcs_iInv_C_sensed_pu  =  PCS_CLA_Ad2Pu(0,PCS_IINV_C_READ_AD,tCpu2Cla.Ilac_Coffset)*2.0f*tCpu2Cla.IInvC_Calibrat;
    //输出相电压
    tClaPrivate.Pcs_vGrid_AB_sensed_pu  = PCS_CLA_Ad2Pu(0,PCS_VGRID_A_READ_AD,tCpu2Cla.VgridA_Calibrat)*2.0f;
    tClaPrivate.Pcs_vGrid_BC_sensed_pu  = PCS_CLA_Ad2Pu(0,PCS_VGRID_B_READ_AD,tCpu2Cla.VgridB_Calibrat)*2.0f;
    tClaPrivate.Pcs_vGrid_CA_sensed_pu  = PCS_CLA_Ad2Pu(0,PCS_VGRID_C_READ_AD,tCpu2Cla.VgridC_Calibrat)*2.0f;
    tClaPrivate.Pcs_vGrid_A_sensed_pu  = (tClaPrivate.Pcs_vGrid_AB_sensed_pu - tClaPrivate.Pcs_vGrid_CA_sensed_pu)*0.3333333f;
    tClaPrivate.Pcs_vGrid_B_sensed_pu  = (tClaPrivate.Pcs_vGrid_BC_sensed_pu - tClaPrivate.Pcs_vGrid_AB_sensed_pu)*0.3333333f;
    tClaPrivate.Pcs_vGrid_C_sensed_pu  = (tClaPrivate.Pcs_vGrid_CA_sensed_pu - tClaPrivate.Pcs_vGrid_BC_sensed_pu)*0.3333333f;

    //逆变电压
    tClaPrivate.Pcs_vInv_A_sensed_pu   = PCS_CLA_Ad2Pu(0,PCS_VINV_A_READ_AD,tCpu2Cla.VInvA_Calibrat)*2.0f;
    tClaPrivate.Pcs_vInv_B_sensed_pu   = PCS_CLA_Ad2Pu(0,PCS_VINV_B_READ_AD,tCpu2Cla.VInvB_Calibrat)*2.0f;
    tClaPrivate.Pcs_vInv_C_sensed_pu   = PCS_CLA_Ad2Pu(0,PCS_VINV_C_READ_AD,tCpu2Cla.VInvC_Calibrat)*2.0f;
    //直流电压电流
    tClaPrivate.Pcs_vBusP_sensed_pu    = PCS_CLA_Ad2Pu(1,PCS_VDCP_READ_AD,1.0f)*tCpu2Cla.VdcP_Calibrat;
    tClaPrivate.Pcs_vBusN_sensed_pu    = PCS_CLA_Ad2Pu(1,PCS_VDCN_READ_AD,1.0f)*tCpu2Cla.VdcN_Calibrat;
    tClaPrivate.Pcs_vBatt_sensed_pu    = PCS_CLA_Ad2Pu(0,PCS_VDC_READ_AD,tCpu2Cla.Vdc_Calibrat);
    tClaPrivate.Pcs_iBus_sensed_pu     = PCS_CLA_Ad2Pu(0,PCS_IDC_READ_AD,tCpu2Cla.Idc_offset)*tCpu2Cla.Idc_Calibrat;
    tClaPrivate.Pcs_iBusN_sensed_pu    = PCS_CLA_Ad2Pu(0,PCS_IMN_READ_AD,tCpu2Cla.IdcN_offset)*tCpu2Cla.IN_Calibrat;

    tClaPrivate.Pcs_IBatt_pu           = order1_lowFliter(tClaPrivate.Pcs_iBus_sensed_pu,0);
    tClaPrivate.Pcs_VBusP_pu           = order1_lowFliter(tClaPrivate.Pcs_vBusP_sensed_pu,2);
    tClaPrivate.Pcs_VBusN_pu           = order1_lowFliter(tClaPrivate.Pcs_vBusN_sensed_pu,3);

    tClaPrivate.Pcs_VBatt_pu           = order1_lowFliter(tClaPrivate.Pcs_vBatt_sensed_pu,1);

    tCla2Cpu.Pcs_iGrid_A_sensed_pu     = tClaPrivate.Pcs_iGrid_A_sensed_pu;
    tCla2Cpu.Pcs_iGrid_B_sensed_pu     = tClaPrivate.Pcs_iGrid_B_sensed_pu;
    tCla2Cpu.Pcs_iGrid_C_sensed_pu     = tClaPrivate.Pcs_iGrid_C_sensed_pu;

    tCla2Cpu.Pcs_iInv_A_sensed_pu      = tClaPrivate.Pcs_iInv_A_sensed_pu;
    tCla2Cpu.Pcs_iInv_B_sensed_pu      = tClaPrivate.Pcs_iInv_B_sensed_pu;
    tCla2Cpu.Pcs_iInv_C_sensed_pu      = tClaPrivate.Pcs_iInv_C_sensed_pu;

    tCla2Cpu.Pcs_vInv_A_sensed_pu      = tClaPrivate.Pcs_vInv_A_sensed_pu;
    tCla2Cpu.Pcs_vInv_B_sensed_pu      = tClaPrivate.Pcs_vInv_B_sensed_pu;
    tCla2Cpu.Pcs_vInv_C_sensed_pu      = tClaPrivate.Pcs_vInv_C_sensed_pu;

    tCla2Cpu.Pcs_vGrid_A_sensed_pu     = tClaPrivate.Pcs_vGrid_A_sensed_pu;
    tCla2Cpu.Pcs_vGrid_B_sensed_pu     = tClaPrivate.Pcs_vGrid_B_sensed_pu;
    tCla2Cpu.Pcs_vGrid_C_sensed_pu     = tClaPrivate.Pcs_vGrid_C_sensed_pu;

    tCla2Cpu.Pcs_vGrid_AB_sensed_pu     = tClaPrivate.Pcs_vGrid_AB_sensed_pu;
    tCla2Cpu.Pcs_vGrid_BC_sensed_pu     = tClaPrivate.Pcs_vGrid_BC_sensed_pu;
    tCla2Cpu.Pcs_vGrid_CA_sensed_pu     = tClaPrivate.Pcs_vGrid_CA_sensed_pu;

    tCla2Cpu.Pcs_vBusP_sensed_pu       = tClaPrivate.Pcs_VBusP_pu;
    tCla2Cpu.Pcs_vBusN_sensed_pu       = tClaPrivate.Pcs_VBusN_pu;
    tClaPrivate.Pcs_VBus_pu            = tClaPrivate.Pcs_VBusP_pu + tClaPrivate.Pcs_VBusN_pu;
    tCla2Cpu.Pcs_vBus_sensed_pu        = tClaPrivate.Pcs_VBus_pu;

    tCla2Cpu.Pcs_iBus_sensed_pu        = tClaPrivate.Pcs_IBatt_pu;//tClaPrivate.Pcs_iBus_sensed_pu;
    tCla2Cpu.Pcs_iBusN_sensed_pu       = tClaPrivate.Pcs_iBusN_sensed_pu;
    tCla2Cpu.Pcs_vBatt_sensed_pu        =tClaPrivate.Pcs_VBatt_pu;

    tClaPrivate.Pcs_vBus_DC   = tClaPrivate.Pcs_VBus_pu*PCS_VDC_MAX_SENSE_VOLTS;
//    tClaPrivate.Pcs_vBus_DC   = tClaPrivate.Pcs_VBatt_pu*PCS_VBATT_MAX_SENSE_VOLTS;
    tClaPrivate.Pcs_iBus_DC   = tClaPrivate.Pcs_IBatt_pu*PCS_IDC_MAX_SENSE_VOLTS;
}

void PCS_CLA_RunTransform(void)
{
    if(tCpu2Cla.WorkMode == CLA_GRID_DISCONNECTED)//离网
    {
        tClaPrivate.Pcs_CosRef          = tCpu2Cla.Pcs_cosine;
        tClaPrivate.Pcs_SinRef          = tCpu2Cla.Pcs_sine;
    }
    else
    {
        tClaPrivate.Pcs_CosRef          = tCpu2Cla.Pcs_Gridcosine;
        tClaPrivate.Pcs_SinRef          = tCpu2Cla.Pcs_Gridsine;
    }
    //电网电流CLARK&PARK变换
    ABC_DQ0_POS_run(&PCS_iGrid_dq0_pos,
                    tClaPrivate.Pcs_iGrid_A_sensed_pu,
                    tClaPrivate.Pcs_iGrid_B_sensed_pu,
                    tClaPrivate.Pcs_iGrid_C_sensed_pu,
                    tClaPrivate.Pcs_SinRef, tClaPrivate.Pcs_CosRef);

    //电感电流CLARK&PARK变换
    ABC_DQ0_POS_run(&PCS_iInv_dq0_pos,
                    tClaPrivate.Pcs_iInv_A_sensed_pu,
                    tClaPrivate.Pcs_iInv_B_sensed_pu,
                    tClaPrivate.Pcs_iInv_C_sensed_pu,
                    tClaPrivate.Pcs_SinRef, tClaPrivate.Pcs_CosRef);

    clarkT_run(&PCS_vGrid_Clark,
                   tClaPrivate.Pcs_vGrid_A_sensed_pu, tClaPrivate.Pcs_vGrid_B_sensed_pu, tClaPrivate.Pcs_vGrid_C_sensed_pu);
    ParkT_Pos_run(&PCS_vGrid_Park_p,
                  PCS_vGrid_Clark.alpha, PCS_vGrid_Clark.beta, PCS_vGrid_Clark.zero,
                  tClaPrivate.Pcs_SinRef, tClaPrivate.Pcs_CosRef);
    ParkT_Neg_run(&PCS_vGrid_Park_n,
                  PCS_vGrid_Clark.alpha, PCS_vGrid_Clark.beta, PCS_vGrid_Clark.zero,
                   tClaPrivate.Pcs_SinRef, tClaPrivate.Pcs_CosRef);
}

void  PCS_CLA_RealTimeData(void)
{
    //电网输出电流
    tClaPrivate.Pcs_IoutMd          = PCS_iGrid_dq0_pos.d*PCS_IGRID_MAX_SENSE_AMPS;
    tClaPrivate.Pcs_IoutMq          = PCS_iGrid_dq0_pos.q*PCS_IGRID_MAX_SENSE_AMPS;
    tClaPrivate.Pcs_IoutMz          = PCS_iGrid_dq0_pos.z*PCS_IGRID_MAX_SENSE_AMPS;
    //电感电流
    tClaPrivate.Pcs_IlMd            = PCS_iInv_dq0_pos.d*PCS_IINV_MAX_SENSE_AMPS;
    tClaPrivate.Pcs_IlMq            = PCS_iInv_dq0_pos.q*PCS_IINV_MAX_SENSE_AMPS;
    tClaPrivate.Pcs_IlMz            = PCS_iInv_dq0_pos.z*PCS_IINV_MAX_SENSE_AMPS;

    tClaPrivate.Pcs_VinvMd          = PCS_vGrid_Park_p.d*PCS_VGRID_MAX_SENSE_VOLTS;
    tClaPrivate.Pcs_VinvMq          = PCS_vGrid_Park_p.q*PCS_VGRID_MAX_SENSE_VOLTS;
    tClaPrivate.Pcs_VinvMz          = PCS_vGrid_Park_p.z*PCS_VGRID_MAX_SENSE_VOLTS;

    tClaPrivate.Pcs_VinvMd_N        = PCS_vGrid_Park_n.d*PCS_VGRID_MAX_SENSE_VOLTS;
    tClaPrivate.Pcs_VinvMq_N        = PCS_vGrid_Park_n.q*PCS_VGRID_MAX_SENSE_VOLTS;
    tClaPrivate.Pcs_VinvMz_N        = PCS_vGrid_Park_n.z*PCS_VGRID_MAX_SENSE_VOLTS;

    tClaPrivate.Pcs_Kp_Udc          = tCpu2Cla.i16_Kp_Udc*0.01f;
    tClaPrivate.Pcs_Ki_Udc          = tCpu2Cla.i16_Ki_Udc*0.01f;
    tClaPrivate.Pcs_Ki_Udc         *= Tcylce;

    tClaPrivate.Pcs_IlKp          = tCpu2Cla.i16_Kp_Iinv*0.01f;
    tClaPrivate.Pcs_IlKi          = tCpu2Cla.i16_Ki_Iinv*0.01f;
    tClaPrivate.Pcs_IlKi         *= Tcylce;

    tClaPrivate.RatedCurrent        = tCpu2Cla.RatedCurrent*SQRT2;//转为DQ值
    tClaPrivate.RatedVoltage        = tCpu2Cla.RatedVoltage*SQRT2;//转为DQ值
    tClaPrivate.RatedPower          = tCpu2Cla.RatedPower;

    tClaPrivate.MaxCurrent          = tClaPrivate.RatedCurrent*1.2f;
    tClaPrivate.MaxVoltage          = tClaPrivate.RatedVoltage*1.2f;
    tClaPrivate.MaxPower            = tClaPrivate.RatedPower*1.2f;
    tCla2Cpu.Pcs_vGrid_Vod          = tClaPrivate.Pcs_VinvMd;
    tCla2Cpu.Pcs_vGrid_Voq          = tClaPrivate.Pcs_VinvMq;

    tCla2Cpu.Pcs_IoutMd             = tClaPrivate.Pcs_IoutMd;
    tCla2Cpu.Pcs_IoutMq             = tClaPrivate.Pcs_IoutMq;

    tCla2Cpu.Pcs_iInv_Iod           = tClaPrivate.Pcs_IlMd;
    tCla2Cpu.Pcs_iInv_Ioq           = tClaPrivate.Pcs_IlMq;

    //逆变电压给定
    tClaPrivate.Pcs_VinvMdRef       = tCpu2Cla.Pcs_VinvMdRef*SQRT2;
    tClaPrivate.Pcs_PacRef          = tCpu2Cla.Pcs_PacRef*1000.0f;
    tClaPrivate.Pcs_QacRef          = tCpu2Cla.Pcs_QacRef*1000.0f;
    //交流恒流电流给定
    tClaPrivate.Pcs_ACIoutRef       = tCpu2Cla.Pcs_ACIoutRef*SQRT2;

    tClaPrivate.Pcs_VdcRef          = tCpu2Cla.Pcs_VdcRef;
    tClaPrivate.Pcs_IdcRef          = tCpu2Cla.Pcs_IdcRef;

//    tClaPrivate.Pcs_vBus_DC         = tCpu2Cla.Pcs_VdcRms;
//    //总有功功率
//    tClaPrivate.Pcs_activePower     =  (tClaPrivate.Pcs_VinvMd * tClaPrivate.Pcs_IoutMd +
//                                       tClaPrivate.Pcs_VinvMq * tClaPrivate.Pcs_IoutMq) * 1.5f;//(3.0f / 2.0f)
//    //总无功功率
//    tClaPrivate.Pcs_reactivePower   = (tClaPrivate.Pcs_VinvMd * tClaPrivate.Pcs_IoutMq -
//                                      tClaPrivate.Pcs_VinvMq * tClaPrivate.Pcs_IoutMd) * 1.5f;

}

