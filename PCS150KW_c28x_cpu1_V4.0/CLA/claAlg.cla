//   tClaPrivate.Pcs_IinvMdRef_P    = satF32(tClaPrivate.Pcs_IinvMdRef_P,INV3P_VDREGOUTLIM_N,INV3P_VDREGOUTLIM_P);

   //正序Q轴调节
   tClaPrivate.Pcs_ErrorVinvMq    = 0.0f - tClaPrivate.Pcs_VinvMq;
//   tClaPrivate.Pcs_ErrorVinvMq    = satF32(tClaPrivate.Pcs_ErrorVinvMq,INV3P_VERRLIM_N,INV3P_VERRLIM_P);
   tClaPrivate.Pcs_VinvQRegOut    = tClaPrivate.Pcs_ErrorVinvMq * tClaPrivate.Pcs_VinvKp + tClaPrivate.Pcs_VinvQRegIOut;
   tClaPrivate.Pcs_VinvQRegOut    = satF32(tClaPrivate.Pcs_VinvQRegOut,(0.0f-tClaPrivate.MaxCurrent)*4.0f,tClaPrivate.MaxCurrent*4.0f);
   tClaPrivate.Pcs_VinvQRegIOut  += tClaPrivate.Pcs_ErrorVinvMq * tClaPrivate.Pcs_VinvKi;
   tClaPrivate.Pcs_VinvQRegIOut   = satF32(tClaPrivate.Pcs_VinvQRegIOut,(0.0f-tClaPrivate.MaxCurrent)*2.0f,tClaPrivate.MaxCurrent*2.0f);

   tClaPrivate.Pcs_IinvMqRef_P    = tClaPrivate.Pcs_VinvQRegOut+(tClaPrivate.Pcs_VinvMd*PI2*GridFreq*Cf);
//   tClaPrivate.Pcs_IinvMqRef_P    = satF32(tClaPrivate.Pcs_IinvMqRef_P,INV3P_VDREGOUTLIM_N,INV3P_VDREGOUTLIM_P);

   //负序D轴调节
  tClaPrivate.Pcs_ErrorVinvMd_N   = 0.0f - tClaPrivate.Pcs_VinvMd_N;
//  tClaPrivate.Pcs_ErrorVinvMd_N   = satF32(tClaPrivate.Pcs_ErrorVinvMd_N,INV3P_VERRLIM_N,INV3P_VERRLIM_P);
  tClaPrivate.Pcs_VinvDRegOut_N   = tClaPrivate.Pcs_ErrorVinvMd_N*tClaPrivate.Pcs_VinvKp + tClaPrivate.Pcs_VinvDRegIOut_N;
  tClaPrivate.Pcs_VinvDRegOut_N   = satF32(tClaPrivate.Pcs_VinvDRegOut_N,(0.0f-tClaPrivate.MaxCurrent)*4.0f,tClaPrivate.MaxCurrent*4.0f);
  tClaPrivate.Pcs_VinvDRegIOut_N += tClaPrivate.Pcs_ErrorVinvMd_N * tClaPrivate.Pcs_VinvKi;
  tClaPrivate.Pcs_VinvDRegIOut_N  = satF32(tClaPrivate.Pcs_VinvDRegIOut_N,(0.0f-tClaPrivate.MaxCurrent)*2.0f,tClaPrivate.MaxCurrent*2.0f);

  tClaPrivate.Pcs_IinvMdRef_N     = tClaPrivate.Pcs_VinvDRegOut_N-(tClaPrivate.Pcs_VinvMq_N*PI2*GridFreq*Cf);
//  tClaPrivate.Pcs_IinvMdRef_N     = satF32(tClaPrivate.Pcs_IinvMdRef_N,INV3P_VDREGOUTLIM_N,INV3P_VDREGOUTLIM_P);

  //负序Q轴调节
  tClaPrivate.Pcs_ErrorVinvMq_N   = 0.0f - tClaPrivate.Pcs_VinvMq_N;
//  tClaPrivate.Pcs_ErrorVinvMq_N   = satF32(tClaPrivate.Pcs_ErrorVinvMq_N,INV3P_VERRLIM_N,INV3P_VERRLIM_P);
  tClaPrivate.Pcs_VinvQRegOut_N   = tClaPrivate.Pcs_ErrorVinvMq_N * tClaPrivate.Pcs_VinvKp + tClaPrivate.Pcs_VinvQRegIOut_N;
  tClaPrivate.Pcs_VinvQRegOut_N   = satF32(tClaPrivate.Pcs_VinvQRegOut_N,(0.0f-tClaPrivate.MaxCurrent)*4.0f,tClaPrivate.MaxCurrent*4.0f);
  tClaPrivate.Pcs_VinvQRegIOut_N += tClaPrivate.Pcs_ErrorVinvMq_N * tClaPrivate.Pcs_VinvKi;
  tClaPrivate.Pcs_VinvQRegIOut_N  = satF32(tClaPrivate.Pcs_VinvQRegIOut_N,(0.0f-tClaPrivate.MaxCurrent)*2.0f,tClaPrivate.MaxCurrent*2.0f);

  tClaPrivate.Pcs_IinvMqRef_N     = tClaPrivate.Pcs_VinvQRegOut_N+(tClaPrivate.Pcs_VinvMd_N*PI2*GridFreq*Cf);
//  tClaPrivate.Pcs_IinvMqRef_N     = satF32(tClaPrivate.Pcs_IinvMqRef_N,INV3P_VDREGOUTLIM_N,INV3P_VDREGOUTLIM_P);

  //正负序控制解耦
  f32_UirAlpha_P    =   tClaPrivate.Pcs_IinvMdRef_P * tClaPrivate.Pcs_CosRef - tClaPrivate.Pcs_IinvMqRef_P * tClaPrivate.Pcs_SinRef;
  f32_UirBeta_P     =   tClaPrivate.Pcs_IinvMdRef_P * tClaPrivate.Pcs_SinRef + tClaPrivate.Pcs_IinvMqRef_P * tClaPrivate.Pcs_CosRef;
  f32_UirAlpha_N    =   tClaPrivate.Pcs_IinvMdRef_N * tClaPrivate.Pcs_CosRef + tClaPrivate.Pcs_IinvMqRef_N * tClaPrivate.Pcs_SinRef;
  f32_UirBeta_N     =  -tClaPrivate.Pcs_IinvMdRef_N * tClaPrivate.Pcs_SinRef + tClaPrivate.Pcs_IinvMqRef_N * tClaPrivate.Pcs_CosRef;
  f32_UirAlpha      =   f32_UirAlpha_P + f32_UirAlpha_N;
  f32_UirBeta       =   f32_UirBeta_P + f32_UirBeta_N;
  tClaPrivate.Pcs_IinvMdRef =  f32_UirAlpha * tClaPrivate.Pcs_CosRef + f32_UirBeta * tClaPrivate.Pcs_SinRef;
  tClaPrivate.Pcs_IinvMdRef = satF32(tClaPrivate.Pcs_IinvMdRef,(0.0f-tClaPrivate.MaxCurrent)*1.0f,tClaPrivate.MaxCurrent*1.0f);
  tClaPrivate.Pcs_IinvMqRef = -f32_UirAlpha * tClaPrivate.Pcs_SinRef + f32_UirBeta * tClaPrivate.Pcs_CosRef;
  tClaPrivate.Pcs_IinvMqRef = satF32(tClaPrivate.Pcs_IinvMqRef,(0.0f-tClaPrivate.MaxCurrent)*1.0f,tClaPrivate.MaxCurrent*1.0f);

  tClaPrivate.Pcs_IinvMzRef = 0.0f;

   tClaPrivate.Pcs_IinvMdRef_1 = tClaPrivate.Pcs_IinvMdRef;
   tClaPrivate.Pcs_IinvMqRef_1 = tClaPrivate.Pcs_IinvMqRef;
   tClaPrivate.Pcs_IinvMzRef_1 = tClaPrivate.Pcs_IinvMzRef;
}



//PI电流内环
void PCS_Int_InvCurrReg(void)
{
    // D轴电流调节
    tClaPrivate.Pcs_IinvMdRef_1 = satF32(tClaPrivate.Pcs_IinvMdRef_1,0.0f-tClaPrivate.MaxCurrent,tClaPrivate.MaxCurrent);
    tClaPrivate.Pcs_ErrorIlMd   = tClaPrivate.Pcs_IinvMdRef_1 - tClaPrivate.Pcs_IlMd;
//    tClaPrivate.Pcs_ErrorIlMd  = satF32(tClaPrivate.Pcs_ErrorIlMd,-20.0f,20.0f);
    tClaPrivate.Pcs_IlDRegOut   = tClaPrivate.Pcs_ErrorIlMd * tClaPrivate.Pcs_IlKp + tClaPrivate.Pcs_IlDRegIOut;
    tClaPrivate.Pcs_IlDRegIOut += tClaPrivate.Pcs_ErrorIlMd * tClaPrivate.Pcs_IlKi;
    tClaPrivate.Pcs_IlDRegIOut  = satF32(tClaPrivate.Pcs_IlDRegIOut,0.0f-tClaPrivate.MaxVoltage,tClaPrivate.MaxVoltage);

    tClaPrivate.Pcs_UirD        = tClaPrivate.Pcs_IlDRegOut + tClaPrivate.Pcs_VinvMd -(tClaPrivate.Pcs_IlMq*PI2*GridFreq*(Lf1+Lf2));
    tClaPrivate.Pcs_UirD        = satF32(tClaPrivate.Pcs_UirD,0.0f-tClaPrivate.MaxVoltage,tClaPrivate.MaxVoltage);

    // Q轴电流调节
    tClaPrivate.Pcs_IinvMqRef_1 = satF32(tClaPrivate.Pcs_IinvMqRef_1,0.0f-tClaPrivate.MaxCurrent,tClaPrivate.MaxCurrent);
    tClaPrivate.Pcs_ErrorIlMq   = tClaPrivate.Pcs_IinvMqRef_1 - tClaPrivate.Pcs_IlMq;
//    tClaPrivate.Pcs_ErrorIlMq  = satF32(tClaPrivate.Pcs_ErrorIlMq,-20.0f,20.0f);
    tClaPrivate.Pcs_IlQRegOut   = tClaPrivate.Pcs_ErrorIlMq * tClaPrivate.Pcs_IlKp + tClaPrivate.Pcs_IlQRegIOut;
    tClaPrivate.Pcs_IlQRegIOut += tClaPrivate.Pcs_ErrorIlMq * tClaPrivate.Pcs_IlKi;
    tClaPrivate.Pcs_IlQRegIOut  = satF32(tClaPrivate.Pcs_IlQRegIOut,0.0f-tClaPrivate.MaxVoltage,tClaPrivate.MaxVoltage);

    tClaPrivate.Pcs_UirQ        = tClaPrivate.Pcs_IlQRegOut + tClaPrivate.Pcs_VinvMq +(tClaPrivate.Pcs_IlMd*PI2*GridFreq*(Lf1+Lf2));
    tClaPrivate.Pcs_UirQ        = satF32(tClaPrivate.Pcs_UirQ,0.0f-tClaPrivate.MaxVoltage,tClaPrivate.MaxVoltage);

    // Z轴电流调节
//   tClaPrivate.Pcs_ErrorIlMz    = tClaPrivate.Pcs_IinvMzRef_1 - tClaPrivate.Pcs_IlMz;
//   tClaPrivate.Pcs_IlZRegOut    = tClaPrivate.Pcs_ErrorIlMz * tClaPrivate.Pcs_IlKp;
//
//   tClaPrivate.Pcs_UirZ         = tClaPrivate.Pcs_IlZRegOut + tClaPrivate.Pcs_VinvMz;
//   tClaPrivate.Pcs_UirZ         = satF32(tClaPrivate.Pcs_UirZ,INV3P_IINVL_OUTLIMN,INV3P_IINVL_OUTLIMP);
    tClaPrivate.Pcs_UirZ        =  0.0f;
}
